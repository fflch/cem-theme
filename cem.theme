<?php
/**
* Implements hook_blog_preprocess_html().
*/
use Drupal\Core\Render\Markup;
use Drupal\Core\Url;
use Drupal\taxonomy\Entity\Term;

// ============================================================================
// Contorno para o CDN da FFLCH
//
// Os arquivos do site ficam em cdn.fflch.usp.br/centrodametropole/public/...,
// mas o Drupal no servidor gera as URLs sem o "public/"
// (ex.: .../centrodametropole/user_files/x.png), o que resulta em 404.
// As funcoes abaixo inserem o "public/" nas URLs que o tema exibe. Se a
// configuracao do servidor for corrigida, a regex deixa de casar e nada muda.
// ============================================================================

const CEM_CDN_REGEX = '#(//cdn\.fflch\.usp\.br/centrodametropole/)(?!public/)#';

/**
 * Insere "public/" em toda URL do CDN do site que nao o tenha.
 */
function _cem_fix_cdn_url(string $text): string {
  $fixed = preg_replace(CEM_CDN_REGEX, '$1public/', $text);
  return $fixed === NULL ? $text : $fixed;
}

/**
 * Gera a URL absoluta de um arquivo a partir do seu URI (ex.: public://...).
 */
function _cem_file_url(string $uri): string {
  return _cem_fix_cdn_url(\Drupal::service('file_url_generator')->generateAbsoluteString($uri));
}

/**
 * Implements hook_preprocess_HOOK() for image.
 *
 * Cobre imagens de campos e de estilos de imagem (views, home, slideshow etc.).
 */
function cem_preprocess_image(&$variables) {
  foreach (['src', 'srcset'] as $attr) {
    if (isset($variables['attributes'][$attr]) && is_string($variables['attributes'][$attr])) {
      $variables['attributes'][$attr] = _cem_fix_cdn_url($variables['attributes'][$attr]);
    }
  }
}

/**
 * Implements hook_preprocess_HOOK() for file_link.
 *
 * Cobre links de campos de arquivo (anexos, PDFs).
 */
function cem_preprocess_file_link(&$variables) {
  if (!isset($variables['link'])) {
    return;
  }
  $link = $variables['link'];
  if (is_array($link) && isset($link['#url']) && $link['#url'] instanceof Url && $link['#url']->isExternal()) {
    $uri = $link['#url']->getUri();
    $fixed = _cem_fix_cdn_url($uri);
    if ($fixed !== $uri) {
      $variables['link']['#url'] = Url::fromUri($fixed, $link['#url']->getOptions());
    }
  }
  elseif (is_string($link) || (is_object($link) && method_exists($link, '__toString'))) {
    $variables['link'] = Markup::create(_cem_fix_cdn_url((string) $link));
  }
}

/**
 * Implements hook_page_attachments_alter().
 *
 * Cobre o favicon e demais <link> do <head>.
 */
function cem_page_attachments_alter(array &$attachments) {
  if (empty($attachments['#attached']['html_head_link'])) {
    return;
  }
  foreach ($attachments['#attached']['html_head_link'] as &$head_link) {
    if (isset($head_link[0]['href']) && is_string($head_link[0]['href'])) {
      $head_link[0]['href'] = _cem_fix_cdn_url($head_link[0]['href']);
    }
  }
}

/**
 * Implements hook_css_alter().
 *
 * Cobre CSS gravado em public:// (ex.: asset_injector).
 */
function cem_css_alter(array &$css, $assets = NULL) {
  _cem_fix_cdn_assets($css);
}

/**
 * Implements hook_js_alter().
 *
 * Cobre JS gravado em public:// (ex.: traducoes em languages/).
 */
function cem_js_alter(array &$javascript, $assets = NULL) {
  _cem_fix_cdn_assets($javascript);
}

/**
 * Aponta assets de public:// para a URL correta do CDN.
 */
function _cem_fix_cdn_assets(array &$items) {
  foreach ($items as &$item) {
    if (!isset($item['data']) || !is_string($item['data'])) {
      continue;
    }
    if (strpos($item['data'], 'public://') === 0) {
      $item['data']       = _cem_file_url($item['data']);
      $item['type']       = 'external';
      $item['preprocess'] = FALSE;
    }
    elseif (($item['type'] ?? '') === 'external') {
      $item['data'] = _cem_fix_cdn_url($item['data']);
    }
  }
}

function cem_preprocess_html(&$variables) {

//  $node = \Drupal::entityTypeManager()->getStorage('node')->load(25);
//  $variables['descricao'] = $node->get('field_page_descricao')->getValue()[0]['value'];
  $language = \Drupal::languageManager()->getCurrentLanguage()->getId();
  $variables['language'] = $language;
}

function cem_preprocess_node(&$variables) {

  $tipo = $variables['node']->getType();
  $lang = $variables['node']->language()->getId();
  $variables['language'] = $lang;

  if($variables['node']->id() == 58){
      date_default_timezone_set('UTC');

      $variables['agenda_ano']          = date("Y");
      $variables['agenda_mes_numerico'] = date("m");
      $variables['agenda_dia']          = date("d");

      if($lang == 'pt-br'){
          setlocale(LC_TIME, "pt_BR.utf8");
          $variables['agenda_mes_texto'] = strftime('%B');
      }
      if($lang == 'en'){
          setlocale(LC_TIME, "english");
          $variables['agenda_mes_texto'] = strftime('%B');
      }
  }
  if($tipo == 'livros') {
        if(isset($variables['node']->get('field_publicacoes_thumbnail')->entity->uri->value)){
            $variables['imagem_livro'] = _cem_file_url($variables['node']->get('field_publicacoes_thumbnail')->entity->uri->value);

        }
        if(isset($variables['node']->get('field_publicacoes_arquivo')->entity->uri->value)) {
            $variables['anexos_livro'] = _cem_file_url($variables['node']->get('field_publicacoes_arquivo')->entity->uri->value);
        }
      $variables['link_resenha'] = $variables['node']->get('field_publicacoes_link')->getString();
      $variables['link_livro']   = $variables['node']->get('field_link_comprar_livro')->getString();

  }
  if($tipo == 'agenda') {
    $variables['lang'] = isset($lang) ? $lang : 'pt-br';
    $data      = $variables['node']->get('field_evento_data')->getString();
    $variables['categoria'] = $variables['node']->get('field_categoria')->getString();
    $data = explode(', ',$data);
    $data_ini = strtotime('-3 hour',strtotime($data[0]));
    
    if(isset($data[1])){
      $data_fim = strtotime('-3 hour',strtotime($data[1]));
    }
    if($lang == 'pt-br'){
      setlocale(LC_TIME, "pt_BR.utf8");
      if(isset($data[1])){
        if(date('Y-m-d', $data_ini) == date('Y-m-d', $data_fim)){
          $variables['data_evento'] =  strftime('%d de %B de %Y %Hh%M', $data_ini) . ' - '. strftime('%Hh%M', $data_fim);
        }else{
          $variables['data_evento'] =  strftime('%d de %B de %Y %Hh%M', $data_ini) . ' a ' . strftime('%d de %B de %Y %Hh%M', $data_fim);
        }
      }else{
        $variables['data_evento'] =  strftime('%d de %B de %Y %Hh%M', $data_ini);
      }
    }else{
      setlocale(LC_TIME, "english");
      if(isset($data[1])){
        if(date('Y-m-d', $data_ini) == date('Y-m-d', $data_fim)){
          $variables['data_evento'] =  strftime('%d of %B of %Y %Hh%M', $data_ini) . ' - '. strftime('%Hh%M', $data_fim);
        }else{
          $variables['data_evento'] =  strftime('%d of %B of %Y %Hh%M', $data_ini) . ' until ' . strftime('%d of %B de %Y %Hh%M', $data_fim);
        }
      }else{
        $variables['data_evento'] =  strftime('%d of %B of %Y %Hh%M', $data_ini);
      }
    }
  }
  if($tipo == 'pessoas' && !$variables['node']->get('field_pesquisadores')->isEmpty()) {
    $tid  = $variables['node']->get('field_pesquisadores')->target_id;
    $term = Term::load($tid);
    if($term) {
      $variables['pesquisadores'] = $term->getName();
      $variables['term_url']      = $term->toUrl()->toString();
    }
  }
  if($tipo == 'page') {
    $url  = $_SERVER['REQUEST_URI'];
    $path = explode('/', $url);
    if(isset($path[3])){
         $variables['tipo_publicacao'] = $path[3];
    }
  }
  if(isset($_GET['month']) && isset($_GET['year'])) {
    $variables['get']['month'] = \Drupal\Component\Utility\XSS::filter($_GET['month']);
    $variables['get']['year'] = \Drupal\Component\Utility\XSS::filter($_GET['year']);
  }else{
    $variables['get']['month'] = Null;
    $variables['get']['year']  = Null;
  }
}

function cem_preprocess_page(&$variables) {

    $language = \Drupal::languageManager()->getCurrentLanguage()->getId();
    if(isset($language)){
        $variables['language_page'] = $language;
    }
    if(isset($variables['node'])){
    if($variables['node']->getType() == 'resolution') {
      $variables['descricao'] = $variables['node']->get('body')->getValue()[0]['value'];
      //SP
      if(isset($variables['node']->get('field_image')->entity->uri->value)) {
        $variables['img_sp'] = _cem_file_url($variables['node']->get('field_image')->entity->uri->value);
      }
      //Londres
      if(isset($variables['node']->get('field_imagem')->entity->uri->value)) {
        $variables['img_londres'] = _cem_file_url($variables['node']->get('field_imagem')->entity->uri->value);
      }
    }
  }
  $variables['ano'] = isset($_GET['ano']) ? $_GET['ano'] : 'all';
 // $variables['hierarquia'] = $variables['node']->get('field_hierarquia')->getString();

}

/**
 * Implements hook_theme_suggestions_HOOK_alter().
 */
function cem_theme_suggestions_page_alter(array &$suggestions, array $variables) {
  if ($node = \Drupal::routeMatch()->getParameter('node')) {
    $content_type = $node->bundle();
    $suggestions[] = 'page__'.$content_type;
  }
}

/**
 * Implements hook_theme_suggestions_HOOK_alter().
 */
function cem_theme_suggestions_html_alter(array &$suggestions, array $variables) {
  if ($node = \Drupal::routeMatch()->getParameter('node')) {
    $content_type = $node->bundle();
    $suggestions[] = 'html__'.$content_type;
  }
}

function cem_preprocess_links__language_block(&$variables) {
    $url = $_SERVER['REQUEST_URI'];
    $lang = explode('/', $url);
    if($lang[1] == 'pt-br') {
      $variables['links']['en']['link']['#title'] = '(english)';
      unset($variables['links']['pt-br']);
    }else {
      $variables['links']['pt-br']['link']['#title'] = '(português)';
      unset($variables['links']['en']);
    }
}


